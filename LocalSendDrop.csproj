<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LocalSendDrop</AssemblyName>
    <RootNamespace>LocalSendDrop</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>2.3.3</Version>
    <!-- No designer is used, so designer-serialization warnings do not apply. -->
    <NoWarn>$(NoWarn);WFO1000;CS8765</NoWarn>

    <!-- One self-contained .exe: colleagues need nothing else installed. -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Certificate PCs must trust before installing the package (see Packaging.cs) -->
    <EmbeddedResource Include="shell\bin\LocalSendDrop.cer" LogicalName="package.cer" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kestrel: the HTTPS receiver. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

</Project>
